# ---------------------------------------------------------------------------
# Chapter Summary Tool - environment template.
# Local defaults are shown; production values are called out in comments.
# Never commit real secrets. See DEPLOYMENT.md for the Laravel Forge setup.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
APP_NAME="Chapter Summary Tool"
APP_ENV=production            # local on your machine
# Generate ONCE (php artisan key:generate) and never change it on the server:
# stored AI provider API keys are encrypted with it and become unreadable if it changes.
APP_KEY=
APP_DEBUG=false               # true only locally
APP_URL=https://example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning             # debug locally

# --- Database (MySQL) --------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chapter_summary_tool
DB_USERNAME=forge
DB_PASSWORD=change-me

# --- Redis -------------------------------------------------------------------
# phpredis is installed on Forge servers. Use "predis" if the PHP redis extension is missing (e.g. local Windows).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

# --- Queue (Redis + Horizon) ---------------------------------------------------
QUEUE_CONNECTION=redis
# Must be greater than the longest job timeout (180 s) and the Horizon timeout (200 s).
REDIS_QUEUE_RETRY_AFTER=240

# --- Cache & session -----------------------------------------------------------
# Cache on Redis (fast, no DB writes). Sessions stay on the database so users
# are not logged out if Redis restarts or is flushed.
CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true    # production is HTTPS; remove locally over http

# --- Horizon (dashboard at /horizon, admin users only) ---------------------------
HORIZON_MAX_PROCESSES=2       # worker processes; keep 2-3 on a 1-2 GB VPS

# --- Broadcasting / Reverb ---------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public values: production = your domain, port 443, https (Nginx proxies wss -> Reverb).
# Local: localhost / 6001 / http.
REVERB_HOST=example.com
REVERB_PORT=443
REVERB_SCHEME=https
# Where the Reverb process itself listens (behind Nginx). Not public.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Comma-separated list of allowed browser origins, as host names without scheme (default: any).
REVERB_ALLOWED_ORIGINS=example.com
# Browser (Vite) values are baked in at build time (npm run build). Rebuild after changing them.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Mail ----------------------------------------------------------------------------
MAIL_MAILER=log               # use smtp/postmark/resend in production if you need real email
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AI providers (seed defaults only) --------------------------------------------------
# Read by database/seeders/AiProviderSeeder via config/services.php. Prefer entering keys
# in the Admin > AI Routing panel; they are stored encrypted with APP_KEY.
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- PDF export (Browsershot + headless Chrome) -------------------------------------------
# Leave paths empty to use Puppeteer's Chrome (installed by `npm ci`) and `node` on PATH.
BROWSERSHOT_CHROME_PATH=
BROWSERSHOT_NODE_BINARY=
BROWSERSHOT_NPM_BINARY=
BROWSERSHOT_NODE_MODULES_PATH=
# true on Linux servers where Chrome's sandbox cannot start (e.g. Ubuntu 24.04). See DEPLOYMENT.md.
BROWSERSHOT_NO_SANDBOX=false
BROWSERSHOT_TIMEOUT=60

# --- Uploads ------------------------------------------------------------------------------
DOCUMENT_MAX_UPLOAD_KB=20480  # keep in sync with Nginx client_max_body_size and PHP upload_max_filesize

# --- Seeding (production only) ---------------------------------------------------------------
# `php artisan db:seed` creates demo accounts ONLY outside production. In production it creates
# one admin if both of these are set (an existing user is promoted, password untouched).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin
